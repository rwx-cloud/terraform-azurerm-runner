variable "rwx_self_hosted_runner_label" {
  description = "Self-hosted runner label shown in RWX."
  type        = string
  validation {
    condition     = can(regex("^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?$", var.rwx_self_hosted_runner_label)) && length(var.rwx_self_hosted_runner_label) <= 63
    error_message = "Use at most 63 letters, digits, or hyphens, starting and ending with a letter or digit."
  }
}

variable "rwx_self_hosted_runner_external_id" {
  description = "32-character external ID generated by RWX for this runner configuration."
  type        = string
  validation {
    condition     = can(regex("^[0-9a-f]{32}$", var.rwx_self_hosted_runner_external_id))
    error_message = "Use the 32-character lowercase hexadecimal external ID shown in RWX."
  }
}

variable "rwx_oidc_issuer" {
  description = "Public HTTPS OIDC issuer shown by RWX; preserve its exact spelling."
  type        = string
  validation {
    condition     = can(regex("^https://[^/?#]+[^?#]*$", var.rwx_oidc_issuer))
    error_message = "The issuer must be a public HTTPS URL without a query or fragment."
  }
}

variable "resource_group_name" {
  description = "Existing dedicated resource group containing only this configuration's runner VMs, NICs, disks, public IPs, and provisioning identity."
  type        = string
}

variable "location" {
  description = "Azure region of the runner resource group and subnet, for example eastus2."
  type        = string
}

variable "subnet_id" {
  description = "Full ARM ID of the existing subnet; it must have outbound internet access and be in the runner subscription and region."
  type        = string
  validation {
    condition     = can(regex("(?i)^/subscriptions/[^/]+/resourceGroups/[^/]+/providers/Microsoft.Network/virtualNetworks/[^/]+/subnets/[^/]+$", var.subnet_id))
    error_message = "Supply the full subnet ARM resource ID."
  }
}
